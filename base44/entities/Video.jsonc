{
  "name": "Video",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Video title"
    },
    "description": {
      "type": "string",
      "description": "Video description/synopsis"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Thumbnail image URL"
    },
    "drive_file_id": {
      "type": "string",
      "description": "Google Drive file ID for the video"
    },
    "category": {
      "type": "string",
      "enum": [
        "film",
        "series",
        "documentary",
        "animation",
        "short_film",
        "music_video"
      ],
      "description": "Video category"
    },
    "genre": {
      "type": "string",
      "description": "Video genre (action, comedy, drama, etc.)"
    },
    "year": {
      "type": "number",
      "description": "Release year"
    },
    "duration": {
      "type": "string",
      "description": "Duration (e.g. 1h 30m)"
    },
    "rating": {
      "type": "string",
      "enum": [
        "G",
        "PG",
        "PG-13",
        "R",
        "NC-17"
      ],
      "description": "Content rating"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Featured on hero banner"
    },
    "view_count": {
      "type": "number",
      "default": 0,
      "description": "Number of views"
    }
  },
  "required": [
    "title",
    "drive_file_id"
  ]
}